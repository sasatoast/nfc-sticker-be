# Dockerビルドから除外するファイル
# 必要に応じてコメントアウトを外してください

# Git
.git
.gitignore

# Logs（本番環境では不要）
log/*
tmp/*
!log/.keep
!tmp/.keep

# Environment（本番では環境変数で管理）
.env
.env.*

# Node modules（本番では不要）
# node_modules/

# Test files（本番では不要）
test/
spec/
coverage/

# Documentation（本番では不要）
# README.md
# swagger/

#tuho Development files（本番では不要）
# .github/
# .vscode/
# .idea/

# Storage（本番では外部ストレージ推奨）
# storage/*
# !storage/.keep

# Temp files
*.swp
*.swo
*~
.DS_Store
